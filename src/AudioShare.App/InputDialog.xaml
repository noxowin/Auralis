<Window x:Class="AudioShare.App.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="Assets/app.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="24,20,24,24">
        <TextBlock x:Name="PromptText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" Margin="0,12,0,0" Padding="10,7" FontSize="14"
                 Background="{StaticResource ControlBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="#FF484848" CaretBrush="{StaticResource TextBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SubtleButton}" Content="取消" Padding="16,8" Margin="0,0,8,0" IsCancel="True" />
            <Button Style="{StaticResource AccentButton}" Content="确定" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
