<Window x:Class="AudioShare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioShare.App.ViewModels"
        xmlns:local="clr-namespace:AudioShare.App"
        Title="AudioShare · 多设备同步播放"
        Width="580" Height="820" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertBoolConverter x:Key="Invert" />

        <DataTemplate x:Key="DeviceTemplate" DataType="{x:Type vm:DeviceViewModel}">
            <Border x:Name="CardRoot" Style="{StaticResource Card}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="Icon" Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="22"
                               VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="StatusLine" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="0,2,0,0">
                            <Run Text="{Binding Status, Mode=OneWay}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding Format, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanToggle}"
                              ToolTip="在这个设备上同时播放" />

                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource LevelMeter}"
                                 Margin="0,10,0,0" Value="{Binding Level, Mode=OneWay}" />

                    <Grid x:Name="Controls" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,0,10,0" ToolTip="音量" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Volume}"
                                SmallChange="1" LargeChange="10" ToolTip="这个设备的音量，超过 100% 是增强（自带防爆音）" />
                        <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}%}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SubTextBrush}" />

                        <TextBlock Grid.Row="1" Text="&#xE916;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,8,10,0" ToolTip="延迟对齐" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="500" Value="{Binding DelayMs}" Margin="0,8,0,0"
                                SmallChange="5" LargeChange="50"
                                ToolTip="让这个设备晚一点出声，用来和蓝牙等延迟较高的设备对齐" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DelayMs, StringFormat={}+{0:0}ms}" Margin="0,8,0,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource SubTextBrush}" />

                        <TextBlock Grid.Row="2" Text="&#xE7F6;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,10,10,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="单声道（左右合并，只戴一只耳机时用）" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource SubTextBrush}" />
                        <CheckBox Grid.Row="2" Grid.Column="2" Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"
                                  Margin="0,10,0,0" IsChecked="{Binding Mono}" />

                        <!-- 音效：点开才显示，保持卡片简洁 -->
                        <TextBlock Grid.Row="3" Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}" Margin="0,10,10,0" />
                        <ToggleButton Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Cursor="Hand"
                                      HorizontalAlignment="Left" IsChecked="{Binding ShowEffects}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <TextBlock Text="{Binding EffectsSummary}" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   Margin="6,2,0,0" Foreground="{StaticResource SubTextBrush}" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border x:Name="EffectsPanel" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                Padding="12,8" CornerRadius="6" Background="#FF252525" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="低音" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding BassDb}" SmallChange="1" LargeChange="3" />
                                <TextBlock Grid.Column="2" Text="{Binding BassDb, StringFormat={}{0:+0;-0;0} dB}" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                <TextBlock Grid.Row="1" Text="人声" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding MidDb}" SmallChange="1" LargeChange="3" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MidDb, StringFormat={}{0:+0;-0;0} dB}" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                <TextBlock Grid.Row="2" Text="高音" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding TrebleDb}" SmallChange="1" LargeChange="3" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TrebleDb, StringFormat={}{0:+0;-0;0} dB}" FontSize="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                                <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,4,0,0"
                                        Style="{StaticResource SubtleButton}" Padding="8,4" Click="OnResetEffects" Tag="{Binding}">
                                    <TextBlock Text="恢复默认" FontSize="12" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ShowEffects}" Value="True">
                    <Setter TargetName="EffectsPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                    <Setter TargetName="Controls" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSource}" Value="True">
                    <Setter TargetName="Controls" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource SuccessBrush}" />
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="#FF3F5A3B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="StatusLine" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
                <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CardRoot" Property="Background" Value="{StaticResource CardHoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>


    <Grid Margin="24,20,8,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 开始按钮 -->
        <Grid Margin="0,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="多设备同步播放" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubTextBrush}" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource AccentButton}" Command="{Binding ToggleCommand}"
                    VerticalAlignment="Center" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Text" Value="&#xE71A;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ToggleText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,16,0">

                <!-- 新版本提示 -->
                <Border Margin="0,0,0,12" Padding="16,12" CornerRadius="8" Background="#FF1E3A4A"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        Visibility="{Binding Update.HasUpdate, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Update.BannerText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Update.Message}" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SubtleButton}" Click="OnUpdateDetails" Margin="0,0,4,0">
                                <TextBlock Text="更新内容" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Click="OnSkipUpdate" Margin="0,0,8,0">
                                <TextBlock Text="跳过" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Padding="14,6" FontSize="13" Click="OnInstallUpdate"
                                    IsEnabled="{Binding Update.IsBusy, Converter={StaticResource Invert}}">
                                <TextBlock Text="立即更新" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 方案 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="方案" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PresetNames}" SelectedItem="{Binding SelectedPreset}"
                              ToolTip="选一个方案，立即切换到保存时的设备设置" />
                    <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Margin="8,0,0,0" Click="OnSavePreset"
                            ToolTip="把当前所有设备的开关、音量、延迟保存成一个方案">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="保存当前" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource SubtleButton}" Click="OnDeletePreset" ToolTip="删除选中的方案">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                </Grid>

                <!-- 声音来源 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="对齐模式（推荐）" FontWeight="SemiBold" />
                                <TextBlock Text="所有设备播放同一份声音，可以用延迟滑块完全对齐，不会有回声"
                                           FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding AlignMode}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding SourceTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SourceHint}"
                                   FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" />
                    </StackPanel>
                </Border>

                <!-- 设备列表标题 -->
                <Grid Margin="0,20,0,8">
                    <TextBlock Text="输出设备" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SubtleButton}" Click="OnCalibrate"
                                ToolTip="用麦克风自动测出每台设备的延迟，并自动对齐">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="自动校准" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}" ToolTip="重新扫描设备">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="刷新" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceTemplate}" />

                <!-- 全局缓冲 + 开机自启 -->
                <Border Style="{StaticResource Card}" Margin="0,4,0,0" Padding="16,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="缓冲" FontWeight="SemiBold" />
                                <TextBlock Text="出现杂音时会自动调大" FontSize="12" Foreground="{StaticResource SubTextBrush}" />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="20" Maximum="300" Value="{Binding BaseLatencyMs}"
                                    SmallChange="5" LargeChange="20" />
                            <TextBlock Grid.Column="2" Text="{Binding BaseLatencyMs, StringFormat={}{0:0} ms}" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Foreground="{StaticResource SubTextBrush}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,12" />
                        <Grid>
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="开机自动启动" FontWeight="SemiBold" />
                                <TextBlock Text="开机后在托盘里运行，上次在共享就自动接着共享" FontSize="12"
                                           Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoStartEnabled}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,12" />
                        <Grid>
                            <StackPanel Margin="0,0,56,0">
                                <TextBlock Text="全局快捷键" FontWeight="SemiBold" />
                                <TextBlock Text="Ctrl+Alt+S 开始/停止共享；Ctrl+Alt+1~9 切换到第 1~9 个方案（窗口藏在托盘里也能用）"
                                           FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding HotkeysEnabled}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorderBrush}" Margin="0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="自动检查更新" FontWeight="SemiBold" />
                                <TextBlock FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap">
                                    <Run Text="{Binding Update.CurrentVersionText, Mode=OneWay}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Update.Message, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Click="OnCheckUpdate" Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="立即检查" FontSize="12" />
                            </Button>
                            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                      IsChecked="{Binding Update.CheckUpdates}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
