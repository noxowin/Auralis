<Window x:Class="AudioShare.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自动校准延迟"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="Assets/app.ico"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <StackPanel Margin="24,20,24,24">
        <TextBlock Text="自动校准延迟" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="每台设备会轮流发出几声「嘀」，程序用麦克风听到的时间差自动算出延迟，并调好每台设备的延迟滑块。"
                   Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="开始前" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubTextBrush}" FontSize="13" LineHeight="22">
                    1. 暂停正在播放的视频或音乐<LineBreak />
                    2. 把所有耳机放到麦克风旁边，彼此离麦克风差不多远<LineBreak />
                    （笔记本的麦克风一般在屏幕上方，或键盘附近）<LineBreak />
                    3. 点「开始校准」，保持安静大约 10 秒
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="用哪个麦克风听" FontWeight="SemiBold" Margin="0,16,0,6" />
        <ComboBox x:Name="MicCombo" DisplayMemberPath="Name" />
        <TextBlock Text="不要选蓝牙耳机上的麦克风：打开它会让蓝牙耳机切到音质很差的通话模式。"
                   FontSize="12" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed" LineHeight="22" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CloseButton" Style="{StaticResource SubtleButton}" Content="关闭" Padding="16,8"
                    Margin="0,0,8,0" Click="OnClose" />
            <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Click="OnStart">
                <TextBlock x:Name="StartText" Text="开始校准" />
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
